<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The one app-initiated network request: the user-tapped model download
         (10-security-architecture.md §3.5). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Kagaz fork: upstream also declared READ/WRITE_EXTERNAL_STORAGE "for model
         storage". The model lives in app-private filesDir, which needs no permission,
         and broad storage permissions draw Play policy review — removed. -->
</manifest>
