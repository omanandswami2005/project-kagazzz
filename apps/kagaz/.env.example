# Kagaz Environment Configuration
# Copy this file to .env.development and .env.production
# NEVER commit actual secrets to the repository

# ============================================================================
# APP CONFIGURATION
# ============================================================================

# App environment
VITE_ENV=development

# App name
VITE_APP_NAME=Kagaz
# App version is NOT an env var — vite.config.ts reads it straight from
# package.json's "version" at build time (2026-07-21 fix: this env var
# used to exist but nothing ever set it, so Settings' About screen always
# showed the '0.0.0-dev' fallback instead of the real version).

# ============================================================================
# CAPACITOR CONFIGURATION
# ============================================================================

# Capacitor app ID (reverse domain notation)
VITE_CAP_APP_ID=com.kagaz.app
VITE_CAP_APP_NAME=Kagaz

# ============================================================================
# API ENDPOINTS (V2+ Backend)
# ============================================================================

# Cloud sync backend
VITE_CLOUD_API_URL=https://api.kagaz.example.com
VITE_CLOUD_API_KEY=your_api_key_here

# Government services API (V3)
VITE_GOV_API_URL=https://gov-services.example.com
VITE_GOV_API_KEY=your_gov_api_key_here

# ============================================================================
# AI CONFIGURATION
# ============================================================================

# WebLLM model settings
VITE_WEBLLM_MODEL=Phi-3.5-mini-instruct-q4f16_1-MLC
VITE_WEBLLM_DEVICE_MEMORY=3000  # MB
VITE_WEBLLM_ENABLE_GPU=true

# Tesseract OCR settings
VITE_TESSERACT_LANG=eng,hin  # English and Hindi
VITE_TESSERACT_WORKER_COUNT=2

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# SQLite database name (Capacitor)
VITE_DB_NAME=kagaz.db
VITE_DB_LOCATION=Documents  # Android/iOS path

# Full-text search settings
VITE_DB_FTS_ENABLED=true

# ============================================================================
# STORAGE CONFIGURATION
# ============================================================================

# Maximum file size (bytes) - 100MB
VITE_MAX_FILE_SIZE=104857600

# Maximum document vault size (bytes) - 5GB
VITE_MAX_VAULT_SIZE=5368709120

# Storage cleanup (days)
VITE_AUTO_CLEANUP_DAYS=90

# ============================================================================
# FEATURES & FLAGS
# ============================================================================

# V1 Features
VITE_ENABLE_VAULT=true
VITE_ENABLE_SCANNER=true
VITE_ENABLE_PDF_ENGINE=true
VITE_ENABLE_IMAGE_ENGINE=true
VITE_ENABLE_AI_ASSISTANT=true
VITE_ENABLE_SEARCH=true
VITE_ENABLE_OCR=true

# V2 Features
VITE_ENABLE_SHARING=false      # Enable at launch
VITE_ENABLE_CLOUD_SYNC=false   # Enable when backend ready

# V3 Features
VITE_ENABLE_CSC_SERVICES=false  # Enable in production

# ============================================================================
# ACCESSIBILITY & LOCALIZATION
# ============================================================================

# Default language
VITE_DEFAULT_LANGUAGE=en

# Supported languages
VITE_SUPPORTED_LANGUAGES=en,hi,ta,te,bn,mr

# Accessibility features
VITE_ENABLE_HIGH_CONTRAST=false
VITE_ENABLE_FONT_SCALING=true
VITE_ENABLE_VOICE_GUIDANCE=true

# ============================================================================
# PERFORMANCE & OPTIMIZATION
# ============================================================================

# Lazy loading settings
VITE_LAZY_LOAD_MODULES=true

# Image optimization
VITE_IMAGE_COMPRESSION_QUALITY=0.85
VITE_THUMBNAIL_SIZE=256  # pixels

# PDF rendering settings
VITE_PDF_RENDER_WORKERS=2
VITE_PDF_CACHE_PAGES=5

# ============================================================================
# LOGGING & DEBUGGING
# ============================================================================

# Log level: 'error', 'warn', 'info', 'debug'
VITE_LOG_LEVEL=info

# Enable detailed logging
VITE_DEBUG_MODE=false

# Enable console logging in production
VITE_ENABLE_PROD_LOGGING=false

# ============================================================================
# ANALYTICS & MONITORING (Optional)
# ============================================================================

# Disable analytics for privacy
VITE_ENABLE_ANALYTICS=false

# Error tracking (Sentry, etc.)
VITE_SENTRY_DSN=
VITE_SENTRY_ENABLED=false

# ============================================================================
# BUILD CONFIGURATION
# ============================================================================

# Source maps in production
VITE_SOURCEMAP=false

# Bundle analysis
VITE_ANALYZE_BUNDLE=false

# ============================================================================
# SECURITY
# ============================================================================

# Enable content security policy
VITE_ENABLE_CSP=true

# Session timeout (minutes)
VITE_SESSION_TIMEOUT=30

# Biometric authentication
VITE_ENABLE_BIOMETRIC=true

# Encryption for documents
VITE_ENABLE_ENCRYPTION=true

# ============================================================================
# DEVELOPMENT ONLY
# ============================================================================

# Mock API responses (development)
VITE_USE_MOCK_API=false

# Hot module replacement
VITE_HMR_ENABLED=true

# Enable Redux DevTools
VITE_ENABLE_DEVTOOLS=true

# ============================================================================
# DEMO-ONLY: LOCAL OLLAMA (not for production builds)
# ============================================================================
# When set, OCR falls back to a local vision model on platforms without native
# ML Kit (the browser/desktop demo). Leave unset in real builds.
# VITE_OLLAMA_URL=http://localhost:11434
# VITE_OLLAMA_VISION_MODEL=gemma4:e2b
