{
  "name": "kagaz",
  "version": "1.0.0",
  "description": "Privacy-first document management app for India",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "type-check": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "type-check:native": "tsgo -p tsconfig.app.json --noEmit",
    "gen:licenses": "node scripts/gen-licenses.mjs",
    "build:analyze": "vite build --mode analyze",
    "build:capacitor": "pnpm build && pnpm exec cap sync",
    "cap:open:android": "pnpm exec cap open android",
    "cap:open:ios": "pnpm exec cap open ios",
    "cap:sync": "pnpm exec cap sync",
    "build:android": "pnpm build:capacitor && cd android && ./gradlew assembleDebug",
    "cap:sync:ios": "pnpm exec cap sync ios",
    "cap:sync:android": "pnpm exec cap sync android"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@capacitor-community/file-opener": "^8.0.1",
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor-community/sqlite": "^8.1.0",
    "@capacitor-community/text-to-speech": "^8.0.1",
    "@capacitor-mlkit/document-scanner": "^8.1.0",
    "@capacitor/android": "^8.4.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/camera": "^8.2.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.4.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@ionic/react": "^8.8.9",
    "@ionic/react-router": "^8.8.9",
    "@kagaz/agent-kit": "workspace:*",
    "@kagaz/design-tokens": "workspace:*",
    "@kagaz/ui": "workspace:*",
    "@mlc-ai/web-llm": "^0.2.84",
    "@pdfsmaller/pdf-decrypt": "^1.0.1",
    "@pdfsmaller/pdf-encrypt": "^1.0.2",
    "@tanstack/react-query": "^5.101.0",
    "browser-image-compression": "^2.0.2",
    "capacitor-secure-storage-plugin": "^0.13.0",
    "clsx": "^2.1.1",
    "comlink": "^4.4.2",
    "dexie": "^4.4.3",
    "docx": "^9.7.1",
    "i18next": "^26.3.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-resources-to-backend": "^1.2.1",
    "jeep-sqlite": "^2.8.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.17.0",
    "mammoth": "^1.12.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "4.6.82",
    "pino": "^10.3.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^5.3.4",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.0",
    "@types/react-router-dom": "^5.3.3",
    "@typescript/native-preview": "beta",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/ui": "^4.1.8",
    "@vitest/web-worker": "4.1.8",
    "axe-core": "^4.12.0",
    "fake-indexeddb": "^6.2.5",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.1.1",
    "pino-pretty": "^13.1.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
