{
  "$schema": "docs/design-system/agent-interface.md#the-agentsitemap",
  "pages": {
    "vault.viewer": {
      "route": "/doc/:id",
      "intent": "View one document — its image or PDF pages — and read or copy the text extracted from it (OCR). Deleting the document and running text extraction are user-only actions.",
      "primary": null,
      "actions": []
    },
    "vault.favorites": {
      "route": "/favorites",
      "intent": "List every document the user has starred as a favorite, newest first, so they can reopen or un-star them quickly.",
      "primary": null,
      "actions": [
        "vaultActions.toggleFavorite"
      ]
    },
    "vault.storage": {
      "route": "/storage",
      "intent": "Show how much device storage the vault uses, broken down by file type, the largest documents, and any reclaimable duplicates.",
      "primary": null,
      "actions": []
    },
    "vault.trash": {
      "route": "/trash",
      "intent": "Show documents the user has deleted, kept for 30 days before permanent removal, so they can restore them or delete them for good. Restore and permanent deletion are user-only actions.",
      "primary": null,
      "actions": []
    },
    "vault.home": {
      "route": "/vault",
      "intent": "Browse the documents in the vault and add new ones from the camera, gallery, or file picker.",
      "primary": "vaultActions.uploadDocument",
      "actions": [
        "vaultActions.uploadDocument",
        "toolsActions.openPdfTools",
        "vaultActions.searchDocuments",
        "vaultActions.openFilters",
        "vaultActions.clearFilters",
        "vaultActions.bulkDelete",
        "vaultActions.bulkFavorite",
        "vaultActions.createFolder",
        "vaultActions.createStarterFolders",
        "vaultActions.moveDocument",
        "vaultActions.toggleFavorite",
        "vaultActions.manageTags",
        "vaultActions.tagDocument",
        "vaultActions.setSortBy",
        "vaultActions.toggleSortDirection"
      ]
    },
    "pdf-tools": {
      "route": "/pdf-tools",
      "intent": "Run on-device PDF operations: merge, split, compress, PDF↔image conversion, password protect/unlock, and fill PDF forms — saving the result to the vault.",
      "primary": "toolsActions.openPdfTools",
      "actions": [
        "toolsActions.openPdfTools"
      ]
    },
    "settings.legal": {
      "route": "/legal/:doc",
      "intent": "Show one of the legal documents — Privacy Policy, Terms & Conditions, or the Open-source licenses/attributions — as read-only text reached from Settings → About.",
      "primary": null,
      "actions": []
    },
    "settings": {
      "route": "/settings",
      "intent": "Change app settings. V1: the UI language (English / हिन्दी) and the colour theme (system / light / dark). Both persist across restarts.",
      "primary": "settingsActions.setTheme",
      "actions": [
        "settingsActions.openSettings",
        "settingsActions.setTheme",
        "settingsActions.setLanguage"
      ]
    }
  },
  "actions": {
    "vault.uploadDocument": {
      "summary": "Add a document to the vault from the camera, the photo gallery, the file picker, or the native document scanner (F-2, Android).",
      "voice": [],
      "requiresConfirmation": false
    },
    "vault.setSortBy": {
      "summary": "Change how the document list is sorted.",
      "voice": [],
      "requiresConfirmation": false
    },
    "vault.toggleFavorite": {
      "summary": "Search the vault by document name, description, or text.",
      "voice": [
        "favorite this",
        "add to favorites",
        "remove from favorites",
        "इसे पसंदीदा बनाओ"
      ],
      "requiresConfirmation": false
    },
    "vault.bulkDelete": {
      "summary": "Delete the currently selected documents.",
      "voice": [],
      "requiresConfirmation": false
    },
    "vault.bulkFavorite": {
      "summary": "Mark the currently selected documents as favorites.",
      "voice": [],
      "requiresConfirmation": false
    },
    "vault.openFilters": {
      "summary": "Open the filter panel to narrow the document list.",
      "voice": [],
      "requiresConfirmation": false
    },
    "vault.clearFilters": {
      "summary": "Clear all active document filters.",
      "voice": [],
      "requiresConfirmation": false
    },
    "vault.createFolder": {
      "summary": "Create a new folder in the current folder.",
      "voice": [],
      "requiresConfirmation": false
    },
    "vault.createStarterFolders": {
      "summary": "Create the default starter folders (Identity, Education, …).",
      "voice": [],
      "requiresConfirmation": false
    },
    "vault.moveDocument": {
      "summary": "Move a document into a folder (or to the vault root).",
      "voice": [],
      "requiresConfirmation": false
    },
    "vault.manageTags": {
      "summary": "Open the tag editor for a document.",
      "voice": [],
      "requiresConfirmation": false
    },
    "vault.tagDocument": {
      "summary": "Tag a document with a label, creating the tag if it is new.",
      "voice": [],
      "requiresConfirmation": false
    },
    "vault.toggleSortDirection": {
      "summary": "Flip the document sort between ascending and descending.",
      "voice": [],
      "requiresConfirmation": false
    },
    "tools.openPdfTools": {
      "summary": "Open the PDF Tools hub to merge, split, compress, convert PDFs and images, watermark a PDF, password-protect/unlock a PDF, or fill a PDF form.",
      "voice": [],
      "requiresConfirmation": false
    },
    "settings.open": {
      "summary": "Open the app Settings screen (appearance/theme, and — as they ship — language, security, and about).",
      "voice": [],
      "requiresConfirmation": false
    }
  },
