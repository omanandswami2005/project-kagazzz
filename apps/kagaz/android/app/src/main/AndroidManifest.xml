<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- F-108 Receive Share (inbound counterpart to F-64/F-65's
                 outbound intents): makes Kagaz appear in the Android share
                 sheet for a single file/image, handled by ShareReceiverPlugin. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="image/*" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="application/msword" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
            </intent-filter>
            <!-- Multi-select share (e.g. several gallery images at once). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <!-- [SEC] 10-security-architecture.md §3.5: the app makes no network calls
         of its own except the user-tapped, one-time AI model download. This
         manifest declares no network permission itself; the merged release
         manifest still carries INTERNET + ACCESS_NETWORK_STATE, from the
         Play-Services ML Kit scanner (ADR-018) and the LiteRT plugin (model
         download). Anything else that needs the network is a release-blocking
         defect until V2 sharing ships with its consent + E2E requirements. -->

    <!-- [SEC] F-15 voice input (05-ai-assistant-module.md §6.1): speech-to-text
         through the platform RecognitionService. RECORD_AUDIO is a hardware (mic)
         permission; the app itself never sends audio anywhere, but the system
         recogniser (usually Google) may process audio on its servers — disclosed
         in the privacy policy and store forms; offline-only is future item AI-X8. Also merged
         from @capacitor-community/speech-recognition; declared here so the
         permission is intentional and auditable. The <queries> lets Android 11+
         resolve the on-device RecognitionService. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>
</manifest>
