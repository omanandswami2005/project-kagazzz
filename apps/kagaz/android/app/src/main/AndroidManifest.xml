<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <!-- [SEC] 10-security-architecture.md §3.5: V1 is 100% offline.
         This manifest must request NO network permission (INTERNET removed;
         debug builds get it from src/debug/AndroidManifest.xml for live
         reload only). Re-adding it here is a release-blocking defect until
         V2 sharing ships with its consent + E2E requirements. -->

    <!-- [SEC] F-15 voice input (05-ai-assistant-module.md §6.1): on-device
         speech-to-text. RECORD_AUDIO is a hardware (mic) permission, NOT a
         network one — audio and transcripts stay on the device. Also merged
         from @capacitor-community/speech-recognition; declared here so the
         permission is intentional and auditable. The <queries> lets Android 11+
         resolve the on-device RecognitionService. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>
</manifest>
