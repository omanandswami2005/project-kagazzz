{
  "name": "kagaz",
  "version": "1.0.0",
  "description": "Privacy-first document management app for India",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write '**/*.{ts,tsx,json,md,css}'",
    "format:check": "prettier --check '**/*.{ts,tsx,json,md,css}'",
    "type-check": "tsc --noEmit",
    "audit": "pnpm audit",
    "audit:fix": "pnpm audit --fix",
    "build:analyze": "vite build --mode analyze",
    "build:capacitor": "pnpm build && pnpm exec cap sync",
    "cap:open:android": "pnpm exec cap open android",
    "cap:open:ios": "pnpm exec cap open ios",
    "cap:sync": "pnpm exec cap sync",
    "cap:sync:ios": "pnpm exec cap sync ios",
    "cap:sync:android": "pnpm exec cap sync android",
    "docs:dev": "cd docs && astro dev",
    "docs:build": "cd docs && astro build",
    "docs:preview": "cd docs && astro preview",
    "prepare": "husky install",
    "precommit": "pnpm lint-staged"
  },
  "keywords": [
    "document",
    "management",
    "privacy",
    "offline",
    "pdf",
    "mobile",
    "india"
  ],
  "author": "@omanandswami2005",
  "license": "MIT",
  "engines": {
    "node": ">=18.17.0",
    "pnpm": ">=8.0.0"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@ionic/react": "^7.5.0",
    "@ionic/react-router": "^7.5.0",
    "react-router-dom": "^7.0.0",
    "zustand": "^4.4.0",
    "@tanstack/react-query": "^5.25.0",
    "typescript": "^5.3.0",
    "pdf-lib": "^1.17.0",
    "pdfjs-dist": "^4.0.0",
    "@mlc-ai/web-llm": "^0.2.0",
    "tesseract.js": "^5.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/camera": "^6.0.0",
    "@capacitor/biometrics": "^6.0.0",
    "@capacitor-community/sqlite": "^6.1.0",
    "@capacitor-community/text-to-speech": "^6.1.0",
    "@capacitor-community/speech-recognition": "^6.1.0",
    "i18next": "^23.7.0",
    "react-i18next": "^13.5.0",
    "tailwindcss": "^3.3.0",
    "clsx": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0",
    "@testing-library/react": "^14.1.0",
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/user-event": "^14.5.0",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-import": "^2.29.0",
    "prettier": "^3.1.0",
    "husky": "^8.0.0",
    "lint-staged": "^15.2.0",
    "@vitest/coverage-v8": "^1.0.0",
    "@vitest/ui": "^1.0.0",
    "@rollup/plugin-visualizer": "^5.12.0",
    "astro": "^4.0.0",
    "@astrojs/starlight": "^0.11.0"
  },
  "pnpm": {
    "overrides": {
      "typescript": "^5.3.0"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
