{
  "name": "kagaz",
  "version": "1.0.0",
  "description": "Privacy-first document management app for India",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,css}\"",
    "type-check": "tsc --noEmit",
    "audit": "pnpm audit",
    "agent:lint": "node scripts/agent-lint.mjs",
    "agent:sitemap": "node scripts/agent-sitemap.mjs",
    "build:analyze": "vite build --mode analyze",
    "build:capacitor": "pnpm build && pnpm exec cap sync",
    "cap:open:android": "pnpm exec cap open android",
    "cap:open:ios": "pnpm exec cap open ios",
    "cap:sync": "pnpm exec cap sync",
    "cap:sync:ios": "pnpm exec cap sync ios",
    "cap:sync:android": "pnpm exec cap sync android",
    "docs:dev": "astro dev",
    "docs:build": "astro build",
    "docs:preview": "astro preview",
    "prepare": "husky",
    "precommit": "lint-staged"
  },
  "keywords": [
    "document",
    "management",
    "privacy",
    "offline",
    "pdf",
    "mobile",
    "india"
  ],
  "author": "@omanandswami2005",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "@ionic/react": "^8.8.9",
    "@ionic/react-router": "^8.8.9",
    "react-router-dom": "^5.3.4",
    "zustand": "^5.0.14",
    "@tanstack/react-query": "^5.101.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.0.227",
    "@pdfsmaller/pdf-encrypt": "^1.0.2",
    "@pdfsmaller/pdf-decrypt": "^1.0.1",
    "@quicktoolsone/pdf-compress": "^2.0.0",
    "browser-image-compression": "^2.0.2",
    "heic-to": "^1.5.2",
    "@mlc-ai/web-llm": "^0.2.84",
    "tesseract.js": "^7.0.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/camera": "^8.2.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor-mlkit/document-scanner": "^8.1.0",
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "capacitor-secure-storage-plugin": "^0.13.0",
    "@capacitor-community/sqlite": "^8.1.0",
    "@capacitor-community/text-to-speech": "^8.0.1",
    "@capacitor-community/speech-recognition": "^7.0.1",
    "jeep-sqlite": "^2.8.0",
    "dexie": "^4.4.3",
    "i18next": "^26.3.1",
    "react-i18next": "^17.0.8",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.17.0",
    "pino": "^10.3.1",
    "comlink": "^4.4.2",
    "jszip": "^3.10.1",
    "zod": "^4.4.3",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@capacitor/cli": "^8.4.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.0",
    "@types/react-router-dom": "^5.3.3",
    "vite": "^8.0.16",
    "@vitejs/plugin-react": "^6.0.2",
    "vitest": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/ui": "^4.1.8",
    "jsdom": "^29.1.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "jest-axe": "^10.0.0",
    "axe-core": "^4.12.0",
    "eslint": "^10.4.1",
    "@eslint/js": "^10.4.1",
    "typescript-eslint": "^8.61.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "tailwindcss": "^4.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "pino-pretty": "^13.1.3",
    "astro": "^6.4.5",
    "@astrojs/starlight": "^0.40.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
