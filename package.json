{
  "name": "kagaz-workspace",
  "version": "1.0.0",
  "description": "Kagaz monorepo — privacy-first document management for India",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.3",
  "scripts": {
    "dev": "turbo run dev --filter=kagaz",
    "build": "turbo run build",
    "preview": "pnpm --filter kagaz preview",
    "test": "turbo run test",
    "test:watch": "pnpm --filter kagaz test:watch",
    "test:coverage": "turbo run test:coverage",
    "test:ui": "pnpm --filter kagaz test:ui",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint .",
    "lint:fix": "eslint --cache --cache-location node_modules/.cache/eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,css}\"",
    "type-check": "turbo run type-check",
    "type-check:native": "pnpm --filter kagaz type-check:native",
    "audit": "pnpm audit -r",
    "security:check": "pnpm audit --audit-level high",
    "audit:lighthouse": "pnpm build && pnpm dlx @lhci/cli@0.15.x autorun",
    "bundle-size": "node scripts/check-bundle-size.mjs",
    "agent:lint": "node scripts/agent-lint.mjs",
    "agent:sitemap": "node scripts/agent-sitemap.mjs",
    "build:analyze": "pnpm --filter kagaz build:analyze",
    "build:capacitor": "pnpm --filter kagaz build:capacitor",
    "docs:dev": "turbo run dev --filter=kagaz-docs",
    "docs:build": "turbo run build --filter=kagaz-docs",
    "docs:preview": "pnpm --filter kagaz-docs preview",
    "prepare": "husky",
    "precommit": "lint-staged"
  },
  "keywords": [
    "document",
    "management",
    "privacy",
    "offline",
    "pdf",
    "mobile",
    "india"
  ],
  "author": "@omanandswami2005",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.4",
    "turbo": "^2.9.17",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
